APP_ENV=production
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=postgresql+psycopg://socialite:replace-password@database:5432/socialite

COOKIE_SECURE=1
AUTO_CREATE_SCHEMA=0
SYNC_UPC_CATALOG=1
EMAIL_VERIFICATION_REQUIRED=1

MAIL_BACKEND=smtp
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USE_SSL=0
MAIL_USERNAME=replace-smtp-user
MAIL_PASSWORD=replace-smtp-password
MAIL_DEFAULT_SENDER=Socialite <no-reply@example.com>
MAIL_TIMEOUT=10

REDIS_URL=rediss://replace-user:replace-password@redis.example.com:6380/0
SOCKETIO_CHANNEL=socialite
SOCKETIO_ASYNC_MODE=gevent
SOCKET_MESSAGE_MAX=20
SOCKET_MESSAGE_WINDOW_SECONDS=60

AWS_ACCESS_KEY_ID=replace-access-key
AWS_SECRET_ACCESS_KEY=replace-secret-key
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1
AWS_S3_BUCKET=replace-media-bucket
S3_PUBLIC_BASE_URL=https://media.example.com
S3_AVATAR_PREFIX=avatars

LOGIN_MAX_FALLOS=3
LOGIN_VENTANA_SEGUNDOS=60
REENVIO_VENTANA_SEGUNDOS=60

PORT=8000
GUNICORN_TIMEOUT=60
GUNICORN_LOG_LEVEL=info
