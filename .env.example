# Entorno local
SECRET_KEY=cambia-esto-por-un-secreto-largo-y-aleatorio
DATABASE_URL=sqlite:///socialite.db
APP_ENV=development

# La consola permite probar el código sin un proveedor de correo.
MAIL_BACKEND=console
MAIL_DEFAULT_SENDER=Socialite <no-reply@tu-dominio.pe>

# Producción: usa MAIL_BACKEND=smtp y completa estos datos.
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USE_SSL=0
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_TIMEOUT=10

EMAIL_VERIFICATION_REQUIRED=1
SYNC_UPC_CATALOG=1
LOGIN_MAX_FALLOS=3
LOGIN_VENTANA_SEGUNDOS=60
REENVIO_VENTANA_SEGUNDOS=60
